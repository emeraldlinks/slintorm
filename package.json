{
  "name": "slintorm",
  "version": "1.10.1",
  "description": "Minimal fully typed orm for typescript",
  "license": "MIT",
  "author": "Joseph Christopher",
  "type": "module",
  "homepage": "https://slintorm.vercel.app",
  "bugs": {
    "url": "https://github.com/emeraldlinks/slintorm/issues"
  },
  "files": [
    "README.md",
    "dist",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "edge-light": "./dist/src/browser.js",
      "workerd": "./dist/src/browser.js",
      "deno": "./dist/src/browser.js",
      "browser": "./dist/src/browser.js",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js",
      "default": "./dist/src/browser.js"
    },
    "./edge": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js",
      "default": "./dist/src/browser.js"
    },
    "./postgrest": {
      "types": "./dist/src/postgrest.d.ts",
      "import": "./dist/src/postgrest.js",
      "default": "./dist/src/postgrest.js"
    },
    "./proxy": {
      "types": "./dist/src/proxy.d.ts",
      "import": "./dist/src/proxy.js",
      "default": "./dist/src/proxy.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emeraldlinks/slintorm.git"
  },
  "bin": {
    "slintorm": "dist/src/bin/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias",
    "prepare": "npm run build",
    "test": "npm run test:suite",
    "test:sqlite": "npm run test:suite",
    "test:pg": "PG_ONLY=1 npm run test:suite",
    "test:mongo": "MONGO_ONLY=1 npm run test:suite",
    "test:mysql": "MYSQL_ONLY=1 npm run test:suite",
    "test:all": "node --import tsx/esm src/slintorm.test.ts",
    "test:suite": "node --import tsx/esm src/slintorm.test.ts",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=249",
    "lint:fix": "eslint src --fix",
    "coverage": "c8 --reporter=text --reporter=json-summary --reporter=lcov --include=src --exclude='src/**/*.test.ts' --exclude='src/schema/**' --exclude='src/bin/**' node --import tsx/esm src/slintorm.test.ts",
    "coverage:check": "npm run coverage && node -e \"const s=require('./coverage/coverage-summary.json');const p=s.total.lines.pct;console.log('line coverage: '+p+'%');if(p<60){console.error('below the 60% floor');process.exit(1)}\"",
    "check": "npm run lint && npm run test:types && npm run test:suite",
    "example:pg": "tsx src/pg-example.ts",
    "example:sqlite": "tsx src/example.ts",
    "cli": "tsx src/bin/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.15.5",
    "@types/sqlite3": "^3.1.11",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "mongodb": "^7.4.0",
    "mysql2": "^3.22.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
